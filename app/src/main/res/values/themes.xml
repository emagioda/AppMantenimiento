<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema principale dell'app -->
    <style name="Theme.MyApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Personalizzazione generale -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Tema dello splash -->
    <style name="Theme.MyApp.Splash" parent="Theme.SplashScreen">
        <!-- Sfondo dello splash -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>

        <!-- Icona o logo da mostrare -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_inset</item>

        <!-- Nessuna animazione (per mantenere il 3D statico) -->
        <item name="windowSplashScreenAnimationDuration">0</item>

        <!-- Sfondo dell'icona (lo lasciamo trasparente) -->
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>

        <!-- Tema applicato dopo lo splash -->
        <item name="postSplashScreenTheme">@style/Theme.MyApp</item>

        <!-- Fallback per Android < 12 -->
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>

</resources>
